# syntax=docker/dockerfile:1
FROM node:22.17.1-bookworm-slim@sha256:2fa754a9ba4d7adbd2a51d182eaabbe355c82b673624035a38c0d42b08724854 AS build
WORKDIR /workspace
ENV PUPPETEER_SKIP_DOWNLOAD=true NX_DAEMON=false NX_ISOLATE_PLUGINS=false \
    NX_NO_CLOUD=true NODE_OPTIONS=--max-old-space-size=3072
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY . .
ARG NX_PROJECT
ARG OUTPUT_PATH
RUN npx nx build "${NX_PROJECT}" --configuration=production --skip-nx-cache \
    && mkdir /out && cp -a "${OUTPUT_PATH}/." /out/

FROM node:22.17.1-bookworm-slim@sha256:2fa754a9ba4d7adbd2a51d182eaabbe355c82b673624035a38c0d42b08724854 AS runtime
WORKDIR /app
ENV NODE_ENV=production PUPPETEER_SKIP_DOWNLOAD=true
COPY --from=build /out/package*.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --no-audit --no-fund
COPY --from=build /out/ ./
COPY deploy/alpha/provision-storage.cjs ./provision-storage.cjs
ARG WAPPS_REVISION
LABEL org.opencontainers.image.revision=$WAPPS_REVISION
USER node
CMD ["node", "main.js"]
