# Optional: copy to deploy/local/.env, then add --env-file deploy/local/.env
# to Docker Compose commands. Defaults work without this file.
LOCAL_PASSWORD=wapps-local-password
LOCAL_INGRESS_SECRET=wapps-local-ingress-secret
LOCAL_EXPORT_SECRET=wapps-local-export-service-secret-2026
LOCAL_ERASURE_SECRET=wapps-local-erasure-service-secret-2026
LOCAL_NOTIFICATION_SECRET=wapps-local-notification-service-secret-2026
# Enable after Account and Discussion migrations and old writer fencing.
REPLY_NOTIFICATION_WORKER_ENABLED=false
MENTION_NOTIFICATION_WORKER_ENABLED=false
FAVORITE_UPDATE_WORKER_ENABLED=false
# Acknowledge only after erasure migrations and fencing old Editorial writers.
EDITORIAL_ERASURE_WORKERS_FENCED=false

# Application uploads use a separately provisioned private, unversioned MinIO bucket.
# Leave disabled until the Editorial migrations and bucket setup are complete.
EDITORIAL_MEDIA_BUCKET=application-images
EDITORIAL_MEDIA_PUBLIC_ORIGIN=http://localhost:4203
EDITORIAL_MEDIA_CLEANUP_ENABLED=false
EDITORIAL_HEALTH_MONITOR_ENABLED=false

# Only needed for the explicitly enabled external integrations.
OPENAI_API_KEY=
EDITORIAL_SERVICE_API_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
GITHUB_TOKEN=
GITHUB_REPO=
ARGOCD_SERVER=
ARGOCD_TOKEN=

# Matching dedicated 32-128 character secret enables the real Explore feed.
# Rotation invalidates older-page tokens; leave empty for an explicit unavailable feed.
LOCAL_EXPLORE_SERVICE_SECRET=
