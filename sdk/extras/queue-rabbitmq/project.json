{
  "name": "sdk-extras-queue-rabbitmq",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "sdk/extras/queue-rabbitmq/src",
  "tags": [
    "type:extras",
    "scope:queue",
    "arch:adapter"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "sdk/extras/queue-rabbitmq/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/sdk/extras/queue-rabbitmq"
      ],
      "options": {
        "command": "tsc --build sdk/extras/queue-rabbitmq/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "commands": [
          "tsc --noEmit -p sdk/extras/queue-rabbitmq/tsconfig.lib.json",
          "tsc --noEmit -p sdk/extras/queue-rabbitmq/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
