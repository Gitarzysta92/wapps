{
  "name": "standard",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "std",
  "sourceRoot": "sdk/kernel/standard/src",
  "tags": [
    "type:foundation",
    "scope:standard",
    "arch:kernel"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/sdk/kernel/standard"
      ],
      "options": {
        "command": "tsc --build sdk/kernel/standard/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
