{
  "name": "primitives",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "prim",
  "sourceRoot": "sdk/kernel/primitives/src",
  "tags": [
    "type:foundation",
    "scope:primitives",
    "arch:kernel"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/sdk/kernel/primitives"
      ],
      "options": {
        "command": "tsc --build sdk/kernel/primitives/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
