{
  "name": "workflow-system",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "sdk/kernel/ontology/workflow/src",
  "tags": [
    "type:foundation",
    "scope:workflow-system",
    "arch:kernel"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/sdk/kernel/ontology/workflow"
      ],
      "options": {
        "command": "tsc --build sdk/kernel/ontology/workflow/tsconfig.lib.json"
      }
    }
  }
}
