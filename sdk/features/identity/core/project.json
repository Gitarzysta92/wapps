{
  "name": "sdk-features-identity-core",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "domains",
  "sourceRoot": "sdk/features/identity/core/src",
  "tags": ["type:domain", "scope:identity", "arch:domain"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/sdk/features/identity/core"],
      "options": {
        "command": "tsc --build sdk/features/identity/core/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "sdk/features/identity/core/jest.config.cjs",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "tsc --noEmit -p sdk/features/identity/core/tsconfig.lib.json",
          "tsc --noEmit -p sdk/features/identity/core/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
