{
  "name": "sdk-identity-infrastructure-local",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "sdk/features/identity/packages/infrastructure/local/src",
  "projectType": "library",
  "tags": ["type:infra", "scope:infrastructure", "arch:adapter"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/sdk/features/identity/packages/infrastructure/local"
      ],
      "options": {
        "command": "tsc --build sdk/features/identity/packages/infrastructure/local/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "sdk/features/identity/packages/infrastructure/local/jest.config.cjs",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "tsc --noEmit -p sdk/features/identity/packages/infrastructure/local/tsconfig.lib.json",
          "tsc --noEmit -p sdk/features/identity/packages/infrastructure/local/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
