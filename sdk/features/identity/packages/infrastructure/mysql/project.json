{
  "name": "sdk-identity-infrastructure-mysql",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "sdk/features/identity/packages/infrastructure/mysql/src",
  "projectType": "library",
  "tags": [
    "type:infra",
    "scope:infrastructure",
    "arch:adapter"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/sdk/features/identity/packages/infrastructure/mysql"
      ],
      "options": {
        "command": "tsc --build sdk/features/identity/packages/infrastructure/mysql/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "sdk/features/identity/packages/infrastructure/mysql/jest.config.cjs",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "commands": [
          "tsc --noEmit -p sdk/features/identity/packages/infrastructure/mysql/tsconfig.lib.json",
          "tsc --noEmit -p sdk/features/identity/packages/infrastructure/mysql/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
