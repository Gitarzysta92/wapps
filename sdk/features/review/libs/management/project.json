{
  "name": "sdk-features-review-management",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "domains",
  "sourceRoot": "sdk/features/review/libs/management/src",
  "tags": ["type:domain", "scope:review", "arch:usecase"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/sdk/features/review/libs/management"],
      "options": {
        "command": "tsc --build sdk/features/review/libs/management/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "sdk/features/review/libs/management/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --noEmit -p sdk/features/review/libs/management/tsconfig.spec.json"
      }
    }
  }
}
