# Server Configuration
EDITORIAL_HOST=0.0.0.0
EDITORIAL_PORT=1337
EDITORIAL_NODE_ENV=development

# Database Configuration (MySQL)
EDITORIAL_DATABASE_HOST=localhost
EDITORIAL_DATABASE_PORT=3306
EDITORIAL_DATABASE_USERNAME=root
EDITORIAL_DATABASE_PASSWORD=password
EDITORIAL_DATABASE_NAME=editorial

# CORS Configuration (optional)
EDITORIAL_CORS_ORIGIN=*

# Private Account -> Editorial export transport. Provision 32-128 URL-safe ASCII
# characters, distinct from INGRESS_AUTH_SECRET. Missing configuration denies export.
ACCOUNT_EXPORT_SOURCE_SECRET=
# Dedicated internal Account erasure writer; distinct from ingress and export secrets.
ACCOUNT_ERASURE_SECRET=
# Set true only after all erasure migrations and fencing pre-erasure API/worker writers.
# Mongo credentials must permit revisioned projection writes. Enable media cleanup below.
EDITORIAL_ERASURE_WORKERS_FENCED=false

# Private application media: provision a dedicated, unversioned, non-public bucket.
# No versioning or lifecycle deletion of the durable zero-byte retirement markers.
EDITORIAL_MEDIA_ENDPOINT=http://localhost:9000
EDITORIAL_MEDIA_BUCKET=application-images
EDITORIAL_MEDIA_ACCESS_KEY=
EDITORIAL_MEDIA_SECRET_KEY=
# Public gateway origin used for canonical image URLs (no path).
EDITORIAL_MEDIA_PUBLIC_ORIGIN=http://localhost:4203
# Enable after ApplicationImageCleanup1791676816000 and bucket provisioning.
EDITORIAL_MEDIA_CLEANUP_ENABLED=false
EDITORIAL_HEALTH_MONITOR_ENABLED=false

# Shared only with Account/Discussion notification readers; distinct from ingress/export/erasure.
NOTIFICATION_SERVICE_SECRET=wapps-local-notification-service-secret-2026
