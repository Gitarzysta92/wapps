{
  "name": "sdk-features-discussion-applications-management",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/services/community/src",
  "projectType": "application",
  "tags": ["type:app", "scope:discussion", "arch:service"],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/sdk/features/discussion/applications/management",
        "main": "apps/services/community/src/main.ts",
        "tsConfig": "apps/services/community/tsconfig.app.json",
        "webpackConfig": "apps/services/community/webpack.config.js"
      },
      "configurations": {
        "development": {
          "optimization": false,
          "sourceMap": true
        },
        "production": {
          "optimization": true,
          "sourceMap": false
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "sdk-features-discussion-applications-management:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "sdk-features-discussion-applications-management:build:development"
        },
        "production": {
          "buildTarget": "sdk-features-discussion-applications-management:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/services/community/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "tsc --noEmit -p apps/services/community/tsconfig.app.json",
          "tsc --noEmit -p apps/services/community/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
