{
  "name": "portals-shared-features-discussion",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "id",
  "sourceRoot": "apps/portals/shared/features/discussion/src",
  "tags": ["type:identity", "scope:discussion", "arch:feature"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "apps/portals/shared/features/discussion/ng-package.json",
        "tsConfig": "apps/portals/shared/features/discussion/tsconfig.lib.json"
      },
      "configurations": {
        "production": {},
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/portals/shared/features/discussion/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --noEmit -p apps/portals/shared/features/discussion/tsconfig.spec.json"
      }
    }
  }
}
