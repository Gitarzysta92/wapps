{
  "name": "portals-shared-features-preferences",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "preferences",
  "sourceRoot": "apps/portals/shared/features/preferences",
  "tags": ["type:lib", "scope:shared", "scope:features", "arch:feature"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "apps/portals/shared/features/preferences/ng-package.json",
        "tsConfig": "apps/portals/shared/features/preferences/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/portals/shared/features/preferences/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --noEmit -p apps/portals/shared/features/preferences/tsconfig.spec.json"
      }
    }
  }
}
