{
  "name": "portals-shared-features-my-favorites",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "my-favorites",
  "sourceRoot": "apps/portals/shared/features/my-favorites/src",
  "tags": [
    "type:lib",
    "scope:shared",
    "scope:features",
    "arch:feature"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "apps/portals/shared/features/my-favorites/ng-package.json",
        "tsConfig": "apps/portals/shared/features/my-favorites/tsconfig.lib.json"
      },
      "configurations": {
        "production": {},
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/portals/shared/features/my-favorites/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "command": "tsc --noEmit -p apps/portals/shared/features/my-favorites/tsconfig.spec.json"
      }
    }
  }
}
