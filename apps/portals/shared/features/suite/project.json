{
  "name": "portals-shared-features-suite",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "suite",
  "sourceRoot": "apps/portals/shared/features/suite/src",
  "tags": [
    "type:feature",
    "scope:suite",
    "arch:feature"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "apps/portals/shared/features/suite/ng-package.json",
        "tsConfig": "apps/portals/shared/features/suite/tsconfig.lib.json"
      },
      "configurations": {
        "production": {},
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "apps/portals/shared/features/suite/jest.config.ts",
        "passWithNoTests": false
      }
    }
  }
}
