{
  "name": "portals-shared-cross-cutting-configuration",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "id",
  "sourceRoot": "apps/portals/shared/cross-cutting/configuration",
  "tags": [
    "type:cross-cutting",
    "scope:configuration",
    "arch:portal-support"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/portals/shared/cross-cutting/configuration",
        "main": "apps/portals/shared/cross-cutting/configuration/src/index.ts",
        "tsConfig": "apps/portals/shared/cross-cutting/configuration/tsconfig.lib.json",
        "assets": [
          "apps/portals/shared/cross-cutting/configuration/*.md"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
