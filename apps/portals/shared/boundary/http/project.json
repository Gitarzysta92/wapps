{
  "name": "portals-shared-boundary-http",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "id",
  "sourceRoot": "apps/portals/shared/boundary/http/src",
  "tags": [
    "type:boundary",
    "scope:http",
    "arch:boundary"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/portals/shared/boundary/http",
        "main": "apps/portals/shared/boundary/http/src/index.ts",
        "tsConfig": "apps/portals/shared/boundary/http/tsconfig.lib.json",
        "assets": [
          "apps/portals/shared/boundary/http/*.md"
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
