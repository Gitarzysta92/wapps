{
  "name": "aggregator-angular",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "app",
  "sourceRoot": "apps/portals/aggregator/application/src",
  "tags": [
    "type:lib",
    "arch:portal"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "apps/portals/aggregator/application/ng-package.json",
        "tsConfig": "apps/portals/aggregator/application/tsconfig.lib.json"
      },
      "configurations": {
        "production": {},
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/portals/aggregator/application/jest.config.ts",
        "passWithNoTests": false
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p apps/portals/aggregator/application/tsconfig.app.json",
          "tsc --noEmit -p apps/portals/aggregator/application/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
