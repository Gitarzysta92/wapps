{
  "name": "aggregator-csr",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/portals/aggregator/entrypoints/csr/src",
  "tags": [
    "type:app",
    "arch:entrypoint"
  ],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "dependsOn": [],
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/portals/aggregator/entrypoints/csr",
        "index": "apps/portals/aggregator/entrypoints/csr/src/index.html",
        "main": "apps/portals/aggregator/entrypoints/csr/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/portals/aggregator/entrypoints/csr/tsconfig.app.json",
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs",
            "libs/ui/design-system/src"
          ]
        },
        "assets": [
          "apps/portals/aggregator/entrypoints/csr/src/assets",
          {
            "glob": "**/*",
            "input": "apps/portals/aggregator/entrypoints/csr/src/.well-known",
            "output": ".well-known"
          },
          {
            "glob": "**/*",
            "input": "node_modules/@taiga-ui/icons/src",
            "output": "assets/taiga-ui/icons"
          }
        ],
        "styles": [
          "apps/portals/aggregator/application/src/styles.scss",
          {
            "input": "node_modules/@taiga-ui/core/styles/taiga-ui-theme.less",
            "bundleName": "taiga-theme"
          }
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": true
            },
            "fonts": false
          },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "1.5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        },
        "demo": {
          "fileReplacements": [
            {
              "replace": "apps/portals/aggregator/application/src/catalog-mode.ts",
              "with": "apps/portals/aggregator/application/src/catalog-mode.demo.ts"
            }
          ]
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "buildTarget": "aggregator-csr:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "aggregator-csr:build:production"
        },
        "development": {
          "buildTarget": "aggregator-csr:build:development"
        },
        "demo": {
          "buildTarget": "aggregator-csr:build:development,demo"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "browserTarget": "aggregator-csr:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
