{
  "name": "ui-registration",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "ui",
  "sourceRoot": "libs/ui/registration/src",
  "tags": [
    "type:ui",
    "scope:registration",
    "arch:ui"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "libs/ui/registration/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ui/registration/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/ui/registration/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
