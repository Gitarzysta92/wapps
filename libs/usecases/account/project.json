{
  "name": "wapps-account",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "domains",
  "sourceRoot": "libs/usecases/account/src",
  "tags": [
    "type:domain",
    "scope:identity",
    "arch:usecase"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/libs/usecases/account"
      ],
      "options": {
        "command": "tsc --build libs/usecases/account/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/usecases/account/jest.config.cjs",
        "passWithNoTests": false
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "commands": [
          "tsc --noEmit -p libs/usecases/account/tsconfig.lib.json",
          "tsc --noEmit -p libs/usecases/account/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
