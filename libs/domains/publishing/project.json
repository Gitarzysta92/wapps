{
  "name": "domains-publishing",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "domains",
  "sourceRoot": "libs/domains/publishing/src",
  "tags": [
    "type:domain",
    "scope:publishing",
    "arch:domain"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/domains/publishing"
      ],
      "options": {
        "command": "tsc --build libs/domains/publishing/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
