{
  "name": "domains-feed",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "domains",
  "sourceRoot": "libs/domains/feed/src",
  "tags": [
    "type:domain",
    "scope:feed",
    "arch:domain"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/domains/feed"
      ],
      "options": {
        "command": "tsc --build libs/domains/feed/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "libs/domains/feed/jest.config.cjs",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "commands": [
          "tsc --noEmit -p libs/domains/feed/tsconfig.lib.json",
          "tsc --noEmit -p libs/domains/feed/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
