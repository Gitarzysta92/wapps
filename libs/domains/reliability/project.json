{
  "name": "domains-reliability",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "domains",
  "sourceRoot": "libs/domains/reliability/src",
  "tags": ["type:domain", "scope:reliability", "arch:domain"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/domains/reliability"],
      "options": {
        "command": "tsc --build libs/domains/reliability/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "libs/domains/reliability/jest.config.cjs",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "commands": [
          "tsc --noEmit -p libs/domains/reliability/tsconfig.lib.json",
          "tsc --noEmit -p libs/domains/reliability/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    }
  }
}
