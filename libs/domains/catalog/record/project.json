{
  "name": "catalog-record",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "cat",
  "sourceRoot": "libs/domains/catalog/record/src",
  "tags": [
    "type:domain",
    "scope:catalog",
    "arch:domain"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/domains/catalog/record"
      ],
      "options": {
        "command": "tsc --build libs/domains/catalog/record/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/domains/catalog/record/jest.config.ts",
        "passWithNoTests": false
      }
    }
  }
}
