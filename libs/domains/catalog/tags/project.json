{
  "name": "catalog-tags",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "cat",
  "sourceRoot": "libs/domains/catalog/tags/src",
  "tags": [
    "type:domain",
    "scope:catalog",
    "arch:domain"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/domains/catalog/tags"
      ],
      "options": {
        "command": "tsc --build libs/domains/catalog/tags/tsconfig.lib.json"
      }
    }
  }
}
