{
  "name": "domains-publication-article",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "prefix": "domains",
  "sourceRoot": "libs/domains/publication/article/src",
  "tags": [
    "type:domain",
    "scope:publication",
    "arch:domain"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "libs/domains/publication/article/jest.config.ts",
        "passWithNoTests": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "tsc --noEmit -p libs/domains/publication/article/tsconfig.spec.json"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/domains/publication/article"
      ],
      "options": {
        "command": "tsc --build libs/domains/publication/article/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
